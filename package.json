{
  "name": "ysk-bill-js-plugin",
  "displayName": "云时空二开表单js脚本工具箱",
  "description": "云时空二开表单js脚本工具箱 — 浏览、编辑、保存数据库中的 JS 脚本",
  "version": "0.2.1",
  "publisher": "dingxs",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ysk-bill-js-plugin",
          "title": "YSK",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ysk-bill-js-plugin": [
        {
          "type": "tree",
          "id": "ysk-bill-js-plugin-bills",
          "name": "脚本列表",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "ysk-bill-js-plugin.searchBills",
        "title": "YSK:搜索表单",
        "icon": "$(search)"
      },
      {
        "command": "ysk-bill-js-plugin.refreshBills",
        "title": "YSK:刷新表单列表",
        "icon": "$(refresh)"
      },
      {
        "command": "ysk-bill-js-plugin.checkAllBills",
        "title": "YSK:全选表单",
        "icon": "$(check-all)"
      },
      {
        "command": "ysk-bill-js-plugin.uncheckAllBills",
        "title": "YSK:取消全选表单",
        "icon": "$(close-all)"
      },
      {
        "command": "ysk-bill-js-plugin.downloadCheckedScript",
        "title": "YSK:下载选中的表单",
        "icon": "$(download)"
      },
      {
        "command": "ysk-bill-js-plugin.openScript",
        "title": "YSK:打开脚本",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ysk-bill-js-plugin.openCheckedScript",
        "title": "YSK:打开选中的脚本",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ysk-bill-js-plugin.saveScript",
        "title": "YSK:保存脚本到数据库",
        "icon": "$(save)"
      },
      {
        "command": "ysk-bill-js-plugin.copyScriptContent",
        "title": "YSK:复制脚本内容",
        "icon": "$(copy)"
      },
      {
        "command": "ysk-bill-js-plugin.syncScript",
        "title": "YSK:从数据库同步",
        "icon": "$(sync)"
      },
      {
        "command": "ysk-bill-js-plugin.syncScriptToGit",
        "title": "YSK:同步脚本到 Git",
        "icon": "$(git)"
      }
    ],
    "submenus": [
      {
        "id": "ysk.batchSubmenu",
        "label": "批量操作",
        "icon": "$(checklist)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ysk-bill-js-plugin.checkAllBills",
          "group": "navigation@1",
          "when": "view == ysk-bill-js-plugin-bills"
        },
        {
          "command": "ysk-bill-js-plugin.uncheckAllBills",
          "group": "navigation@10",
          "when": "view == ysk-bill-js-plugin-bills"
        },
        {
          "submenu": "ysk.batchSubmenu",
          "group": "navigation@50",
          "when": "view == ysk-bill-js-plugin-bills"
        },
        {
          "command": "ysk-bill-js-plugin.searchBills",
          "group": "navigation@99",
          "when": "view == ysk-bill-js-plugin-bills"
        }
      ],
      "ysk.batchSubmenu": [
        {
          "command": "ysk-bill-js-plugin.downloadCheckedScript",
          "group": "1_actions@1"
        },
        {
          "command": "ysk-bill-js-plugin.openCheckedScript",
          "group": "1_actions@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ysk-bill-js-plugin.openScript",
          "when": "view == ysk-bill-js-plugin-bills",
          "group": "inline"
        },
        {
          "command": "ysk-bill-js-plugin.syncScript",
          "when": "view == ysk-bill-js-plugin-bills",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "ysk-bill-js-plugin.copyScriptContent",
          "group": "YSK@1"
        },
        {
          "command": "ysk-bill-js-plugin.syncScriptToGit",
          "group": "YSK@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ysk-bill-js-plugin.saveScript",
        "key": "alt+s",
        "mac": "alt+s"
      },
      {
        "command": "ysk-bill-js-plugin.copyScriptContent",
        "key": "alt+c",
        "mac": "alt+c"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}